import os
import shutil
import logging
from datetime import datetime

LOG_FILE = "organizer.log"

# ---------- Logging setup ----------
logging.basicConfig(
    filename=LOG_FILE,
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)


def get_category(extension: str) -> str:
"""Map a file extension to a friendly category/folder name."""
    categories = {
"Images": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".svg", ".webp"],
"Documents": [".pdf", ".doc", ".docx", ".txt", ".xlsx", ".ppt", ".pptx", ".csv"],
"Videos": [".mp4", ".mkv", ".mov", ".avi"],
"Audio": [".mp3", ".wav", ".flac"],
"Archives": [".zip", ".rar", ".tar", ".gz", ".7z"],
"Code": [".py", ".js", ".html", ".css", ".java", ".cpp", ".c"],
    }
    for category, extensions in categories.items():
        if extension.lower() in extensions:
            return category
    return "Others"


def unique_destination(dest_folder: str, filename: str) -> str:
"""Avoid overwriting files with the same name by adding a counter suffix."""
    base, ext = os.path.splitext(filename)
    candidate = os.path.join(dest_folder, filename)
    counter = 1
    while os.path.exists(candidate):
        candidate = os.path.join(dest_folder, f"{base}_{counter}{ext}")
        counter += 1
    return candidate


def clean_empty_files(target_dir: str) -> int:
"""Remove 0-byte files. Returns count removed."""
    removed = 0
    for root, _, files in os.walk(target_dir):
        for file in files:
            path = os.path.join(root, file)
            try:
                if os.path.isfile(path) and os.path.getsize(path) == 0:
                    os.remove(path)
                    removed += 1
                    logging.info(f"Removed empty file: {path}")
            except OSError as e:
                logging.error(f"Could not remove {path}: {e}")
    return removed


def organize_folder(target_dir: str, clean_empty: bool = True) -> None:
    if not os.path.isdir(target_dir):
        print(f"❌ Error: '{target_dir}' is not a valid directory.")
        logging.error(f"Invalid directory provided: {target_dir}")
        return

    print(f"\n📂 Scanning: {target_dir}")
    moved_count = 0
    error_count = 0

    try:
        entries = [f for f in os.listdir(target_dir) if os.path.isfile(os.path.join(target_dir, f))]
    except OSError as e:
        print(f"❌ Could not read directory: {e}")
        logging.error(f"Could not list directory {target_dir}: {e}")
        return

    for filename in entries:
        if filename == LOG_FILE:
            continue  # don't move our own log file

        source_path = os.path.join(target_dir, filename)
        _, ext = os.path.splitext(filename)
        category = get_category(ext)
        category_folder = os.path.join(target_dir, category)

        try:
            os.makedirs(category_folder, exist_ok=True)
            dest_path = unique_destination(category_folder, filename)
            shutil.move(source_path, dest_path)
            moved_count += 1
            print(f"  ✅ {filename} -> {category}/")
            logging.info(f"Moved '{source_path}' ->'{dest_path}'")
        except (OSError, shutil.Error) as e:
            error_count += 1
            print(f"  ⚠️  Failed to move {filename}: {e}")
            logging.error(f"Failed to move '{source_path}': {e}")

    removed_empty = clean_empty_files(target_dir) if clean_empty else 0

    summary = (
        f"\n📊 Summary: {moved_count} file(s) organized, "
        f"{error_count} error(s), {removed_empty} empty file(s) removed."
    )
    print(summary)
    logging.info(
        f"Run complete for '{target_dir}': moved={moved_count}, "
        f"errors={error_count}, empty_removed={removed_empty}"
    )


def main():
    print("=" * 55)
    print(" Python Automation Script — File Organizer & Cleaner")
    print("=" * 55)

    target_dir = input("Enter the folder path to organize: ").strip().strip('"')
    clean_choice = input("Remove empty files too? (y/n): ").strip().lower()
    clean_empty = clean_choice == "y"

    start_time = datetime.now()
    logging.info(f"--- New run started for: {target_dir} ---")

    try:
        organize_folder(target_dir, clean_empty)
    except Exception as e:  # catch-all safety net
        print(f"❌ Unexpected error: {e}")
        logging.exception("Unexpected error during organize_folder run")

    duration = (datetime.now() - start_time).total_seconds()
    print(f"\n⏱️  Done in {duration:.2f}s. See '{LOG_FILE}' for the full log.")


if __name__ == "__main__":
    main()
